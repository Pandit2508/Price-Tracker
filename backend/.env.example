# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins (your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# --- Supabase (server-side only; never put the service-role key in the frontend) ---
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Scheduler auth: cron-job.org sends "Authorization: Bearer <this>" ---
CRON_SECRET=change-me-to-a-long-random-string

# --- Store catalog endpoint (verify the real path in the browser Network tab) ---
# CATALOG_URL=https://demo.inelabteamdev.com/api/catalog

# --- Scraper tuning (all optional; defaults shown) ---
# HEADED=false
# SLOW_MO_MS=250
# SCRAPE_MAX_ATTEMPTS=4
# SCRAPE_BASE_DELAY_MS=1500
# SCRAPE_NAV_TIMEOUT_MS=20000
# SCRAPE_PRICE_WAIT_MS=15000
# SCRAPE_REVEAL_WAIT_MS=45000
# SCRAPE_AFTER_CLICK_WAIT_MS=30000
# SCRAPE_ATTEMPT_HARD_TIMEOUT_MS=120000
# SCRAPE_CONCURRENCY=1
# SCRAPE_STABLE_READS=2
# SCRAPE_STABLE_GAP_MS=500
# DEBUG_DIR=./debug

# Local only: use the installed Google Chrome instead of Playwright's downloaded Chromium.
# Leave unset on Render (the Docker image already contains Chromium).
# BROWSER_CHANNEL=chrome
